doctype html
html
  head
    title= title
    style.
      body {
        margin: 0;
        padding: 0;
        background: linear-gradient(270deg, #B6FFFE, #48FDFE, #F20BF8, #150390, #1E0C2D);
        background-size: 600% 600%;
        animation: neonBackground 20s ease infinite;
        text-align: center;
        font-family: sans-serif;
        color: white;
      }

      nav {
        background-color: rgba(0, 0, 0, 0.7);
        padding: 10px 20px;
        display: flex;
        justify-content: flex-start;
        gap: 20px;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 10px;
      }

      nav a:hover {
        text-decoration: underline;
      }

      h1, h2 {
        margin: 10px;
      }

      #canvas-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70vh;
      }

      canvas {
        background-color: rgba(0, 0, 0, 0.3);
        border: 2px solid white;
        border-radius: 10px;
      }

      @keyframes neonBackground {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

  body
    nav
      a(href="/") Home
      a(href="/songs") Songs
      a(href="/signout") Sign out
    div
      h1= song
      h2(id='points') Score: 0
      h2(id='highscore') Highscore: 0

    audio(controls='', id='song', hidden)
      source(src=full, type='audio/mp3')

    div(id='canvas-container')
      canvas(id='game')

    script(src="/js/game.js")
