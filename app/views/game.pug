doctype html
html
  head
    title= title
    style.
      @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap');
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(270deg, #B6FFFE, #48FDFE, #F20BF8, #150390, #1E0C2D);
        background-size: 600% 600%;
        animation: neonBackground 20s ease infinite;
        font-family: 'Orbitron', Arial, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow-x: hidden;
      }

      nav {
        background: rgba(10, 0, 32, 0.95);
        box-shadow: 0 2px 24px #7a00ff55;
        padding: 14px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100vw;
      }
      .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .nav-right {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      nav a, .nav-hi {
        color: #fff;
        text-shadow:
          0 0 5px #f0f,
          0 0 10px #0ff,
          0 0 15px #0ff;
        text-decoration: none;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 6px;
        font-size: 1.1rem;
        letter-spacing: 2px;
        transition: background 0.3s, color 0.3s, text-shadow 0.3s;
      }
      nav a:hover {
        background: #1a0033;
        color: #0ff;
        text-shadow:
          0 0 10px #0ff,
          0 0 20px #ff00cc;
      }

      .nav-hi {
        background: transparent;
        pointer-events: none;
        cursor: default;
        margin-right: 0;
      }

      .music-notes {
        position: absolute;
        left: 0;
        top: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 0;
        overflow: visible;
      }
      .music-note {
        position: absolute;
        font-size: 2.5rem;
        color: #fff;
        opacity: 0.65;
        text-shadow:
          0 0 10px #0ff,
          0 0 20px #ff00ff;
        animation: float-notes 8s linear infinite;
      }
      .music-note.n1 { left: 10vw; top: 74vh; font-size: 3rem; color: #0ff; animation-delay: 0s; }
      .music-note.n2 { left: 25vw; top: 60vh; font-size: 2.1rem; color: #ff00ff; animation-delay: 2s; }
      .music-note.n3 { left: 60vw; top: 80vh; font-size: 2.8rem; color: #fff; animation-delay: 3s; }
      .music-note.n4 { left: 75vw; top: 65vh; font-size: 2.4rem; color: #0ff; animation-delay: 1s; }
      .music-note.n5 { left: 50vw; top: 85vh; font-size: 2.7rem; color: #ff00ff; animation-delay: 4s; }
      .music-note.n6 { left: 85vw; top: 90vh; font-size: 2rem; color: #0ff; animation-delay: 5s; }
      @keyframes float-notes {
        0% { transform: translateY(0) scale(1) rotate(0deg);}
        80% {opacity: 0.8;}
        100% { transform: translateY(-85vh) scale(1.1) rotate(15deg); opacity: 0; }
      }

      .game-flex-row {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center; /* Center vertically */
        width: 100vw;
        min-height: 70vh;
        margin-top: 4rem;
        gap: 2.5rem;
      }

      #canvas-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70vh;
      }

      canvas {
        background-color: rgba(0, 0, 0, 0.3);
        border: 2px solid white;
        border-radius: 10px;
      }

      .neon-card {
        background: rgba(25, 0, 50, 0.96);
        padding: 2.5rem 3.5rem 2.5rem 3.5rem;
        border-radius: 20px;
        box-shadow:
          0 0 24px #ff00ffcc,
          0 0 80px #00ffeeb0,
          0 0 8px #fff4;
        color: #fff;
        text-align: center;
        transition: box-shadow 0.3s ease;
        position: relative;
        min-width: 280px;
        max-width: 300px;
        z-index: 1;
        margin: 0;
      }
      .neon-card:hover {
        box-shadow:
          0 0 36px #00ffffcc,
          0 0 100px #ff00ffcc,
          0 0 16px #fff6;
      }
      h1, h2 {
        margin-bottom: 0.7em;
        color: #fff;
        font-size: 2.1rem;
        letter-spacing: 3px;
        text-shadow:
          0 0 10px #ff00ffcc,
          0 0 30px #00ffeeb0,
          0 0 20px #fff6;
      }

      @keyframes neonBackground {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

  body
    nav
      .nav-left
        a(href="/") Devobeats
      .nav-right
        if username
          span.nav-hi Hi, #{username}
          a(href="/songs") Songs
          a(href="/logout") Logout
        else
          a(href="/songs") Songs
          a(href="/login") Login
          a(href="/register") Register

    .game-flex-row
      #canvas-container
        canvas(id='game')
      .neon-card
        h1= song
        h2(id='points') Score: 0
        h2(id='highscore') Highscore: 0

    audio(controls='', id='song', hidden)
      source(src=full, type='audio/mp3')

    if username
      script.
        window.username = !{JSON.stringify(username)};
    script(src="/js/game.js")
