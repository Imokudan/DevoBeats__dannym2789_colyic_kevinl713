doctype html
html
  head
    title= title
  body
    a(href="/") Home
    h1= song
    h2(id='points')= "Points: 0"
    audio(controls='',id='song',hidden)
      source(src=full,type='audio/mp3')
    div(style="margin: auto")
      canvas(id='game', width=1/2, height=1/2, style='border:1px solid #000000;')
    script(src="/js/game.js")
