doctype html
html
  head
    title= title
    style.
    style.
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(270deg, #B6FFFE, #48FDFE, #F20BF8, #150390, #1E0C2D);
        background-size: 600% 600%;
        animation: neonBackground 20s ease infinite;
        font-family: 'Arial', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      nav {
        background-color: rgba(0, 0, 0, 0.8);
        padding: 10px 20px;
        display: flex;
        justify-content: flex-start; /* <-- Move items to the left */
        gap: 20px;
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
      }

      nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 10px 15px;
        border-radius: 5px;
        transition: background 0.3s ease;
      }

      nav a:hover {
        background-color: #333;
      }

      .neon-card {
        margin-top: 4rem;
        background: #1a1a1a;
        padding: 2rem;
        border-radius: 15px;
        box-shadow:
          0 0 10px #ff00ff,
          0 0 20px #ff00ff,
          0 0 40px #ff00ff,
          inset 0 0 10px #ff00ff,
          inset 0 0 20px #ff00ff;
        color: #fff;
        text-align: center;
        transition: box-shadow 0.3s ease;
      }

      .neon-card:hover {
        box-shadow:
          0 0 20px #00ffff,
          0 0 40px #00ffff,
          0 0 80px #00ffff,
          inset 0 0 20px #00ffff,
          inset 0 0 40px #00ffff;
      }

      h1, h2 {
        margin: 10px;
      }

      #canvas-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70vh;
      }

      canvas {
        background-color: rgba(0, 0, 0, 0.3);
        border: 2px solid white;
        border-radius: 10px;
      }

      @keyframes neonBackground {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

  body
    nav
      a(href="/") Devobeats
      a(href="/songs") Songs
      a(href="/signout") Sign out
    div
      h1= song
      h2(id='points') Score: 0
      h2(id='highscore') Highscore: 0

    audio(controls='', id='song', hidden)
      source(src=full, type='audio/mp3')

    div(id='canvas-container')
      canvas(id='game')

    script(src="/js/game.js")
