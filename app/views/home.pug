doctype html
html
  head
    title DevoBeats
    style.
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #1a1a1a;
        font-family: 'Arial', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      nav {
        background-color: rgba(0, 0, 0, 0.8);
        padding: 10px 20px;
        display: flex;
        justify-content: flex-start; /* <-- Move items to the left */
        gap: 20px;
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
      }

      nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 10px 15px;
        border-radius: 5px;
        transition: background 0.3s ease;
      }

      nav a:hover {
        background-color: #333;
      }

      .neon-card {
        margin-top: 4rem;
        background: #1a1a1a;
        padding: 2rem;
        border-radius: 15px;
        box-shadow:
          0 0 10px #ff00ff,
          0 0 20px #ff00ff,
          0 0 40px #ff00ff,
          inset 0 0 10px #ff00ff,
          inset 0 0 20px #ff00ff;
        color: #fff;
        text-align: center;
        transition: box-shadow 0.3s ease;
      }

      .neon-card:hover {
        box-shadow:
          0 0 20px #00ffff,
          0 0 40px #00ffff,
          0 0 80px #00ffff,
          inset 0 0 20px #00ffff,
          inset 0 0 40px #00ffff;
      }
      h1 {
        color: #ff00ff
      }

  body
    nav
      a(href="/") Devobeats
      a(href="/songs") Songs
      a(href="/signin") Sign In
      a(href="/signout") Sign out
    div.neon-card
      h1 Welcome to DevoBeats
