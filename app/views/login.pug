doctype html
html
  head
    title Login | DevoBeats
    style.
      @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap');
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #0f0026;
        font-family: 'Orbitron', Arial, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow-x: hidden;
      }
      nav {
        background: rgba(10, 0, 32, 0.95);
        box-shadow: 0 2px 24px #7a00ff55;
        padding: 14px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100vw;
      }
      .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .nav-right {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      nav a {
        color: #fff;
        text-shadow:
          0 0 5px #f0f,
          0 0 10px #0ff,
          0 0 15px #0ff;
        text-decoration: none;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 6px;
        font-size: 1.1rem;
        letter-spacing: 2px;
        transition: background 0.3s, color 0.3s, text-shadow 0.3s;
      }
      nav a:hover {
        background: #1a0033;
        color: #0ff;
        text-shadow:
          0 0 10px #0ff,
          0 0 20px #ff00cc;
      }
      .center-auth {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100vw;
      }
      .auth-card {
        background: rgba(25, 0, 50, 0.96);
        padding: 2.5rem 2.5rem 2rem 2.5rem;
        border-radius: 20px;
        box-shadow:
          0 0 24px #ff00ffcc,
          0 0 80px #00ffeeb0,
          0 0 8px #fff4;
        color: #fff;
        text-align: center;
        min-width: 320px;
        max-width: 90vw;
      }
      h1 {
        font-size: 2.1rem;
        margin-bottom: 1.5rem;
        text-shadow: 0 0 10px #ff00ffcc, 0 0 30px #00ffeeb0, 0 0 20px #fff6;
      }
      label {
        display: block;
        margin: 1rem 0 0.3rem 0;
        font-weight: bold;
        letter-spacing: 1px;
      }
      input[type="text"], input[type="password"] {
        width: 90%;
        padding: 0.7em;
        border-radius: 8px;
        border: 1px solid #ff00ff88;
        margin-bottom: 1rem;
        background: #1a1a1a;
        color: #fff;
        font-size: 1.1rem;
        outline: none;
        box-shadow: 0 0 8px #ff00ff33;
        transition: border 0.2s;
      }
      input[type="text"]:focus, input[type="password"]:focus {
        border-color: #00ffff;
      }
      button {
        background: #1a1a1a;
        color: #fff;
        font-weight: bold;
        border: 2px solid #ff00ff;
        border-radius: 8px;
        padding: 0.7em 2em;
        font-size: 1.2rem;
        box-shadow: 0 0 10px #ff00ff, 0 0 20px #ff00ff, 0 0 40px #ff00ff;
        cursor: pointer;
        margin-top: 1rem;
        transition: background 0.3s, box-shadow 0.3s, color 0.3s, border 0.3s;
        outline: none;
      }
      button:hover {
        background: #2a2a2a;
        color: #00ffff;
        border: 2px solid #00ffff;
        box-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff, 0 0 80px #00ffff;
      }
      .auth-switch {
        margin-top: 1.2rem;
        font-size: 1rem;
      }
      .auth-switch a {
        color: #0ff;
        text-decoration: underline;
        margin-left: 0.4em;
        transition: color 0.2s;
      }
      .auth-switch a:hover {
        color: #ff00cc;
      }
  body
    nav
      .nav-left
        a(href="/") Devobeats
      .nav-right
        a(href="/songs") Songs
        a(href="/login") Login
        a(href="/register") Register
    .center-auth
      .auth-card
        h1 Login to DevoBeats
        form(action="/login" method="POST" autocomplete="off")
          label(for="username") Username
          input(type="text" name="username" id="username" required autofocus)
          label(for="password") Password
          input(type="password" name="password" id="password" required)
          button(type="submit") Login
        .auth-switch
          | Don't have an account?
          a(href="/register") Register
